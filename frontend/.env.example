# Frontend env vars — note: NUXT_PUBLIC_* values are SHIPPED TO BROWSER.
# Never put secrets here. Server-side secrets belong in backend/.env or workers/.dev.vars.

NUXT_PUBLIC_API_BASE=http://localhost:8080/api
NUXT_PUBLIC_WS_BASE=ws://localhost:8787/ws

# MapLibre tile style URL. Defaults to OpenFreeMap's "liberty" style —
# free vector tiles, no API key, no rate limit. Override only if you
# want to point at your own tile server (MapTiler, Stadia, self-hosted).
NUXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
