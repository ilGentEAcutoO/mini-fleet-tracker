# Frontend env vars — note: NUXT_PUBLIC_* values are SHIPPED TO BROWSER.
# Never put secrets here. Server-side secrets belong in backend/.env or workers/.dev.vars.

NUXT_PUBLIC_API_BASE=http://localhost:8080/api
NUXT_PUBLIC_WS_BASE=ws://localhost:8787/ws

# Google Maps JS API key — MUST be restricted by HTTP referrer in GCP console
# (only https://fleet-tracker.jairukchan.com/* for prod) before first push.
NUXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-js-api-key-restricted-by-http-referrer
NUXT_PUBLIC_MAP_ID=your-google-maps-map-id
