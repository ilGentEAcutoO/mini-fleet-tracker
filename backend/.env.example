# --- App ---
APP_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-32-byte-random-hex
# Shared secret used to authenticate Go -> Durable Object publish calls.
# Must match workers/.dev.vars value.
INTERNAL_PUBLISH_SECRET=replace-with-a-shared-secret-for-do-publish

# --- Cloudflare account ---
CF_ACCOUNT_ID=your-cf-account-id
# API token scoped to: D1 edit, Workers KV edit, R2 admin
CF_API_TOKEN=your-cf-api-token-with-d1-kv-r2-scopes

# --- D1 ---
D1_DATABASE_ID=your-d1-database-id

# --- KV namespaces ---
KV_SESSIONS_NAMESPACE_ID=your-kv-sessions-namespace-id
KV_RATELIMITS_NAMESPACE_ID=your-kv-ratelimits-namespace-id
KV_QUOTAS_NAMESPACE_ID=your-kv-quotas-namespace-id

# --- R2 (S3-compatible endpoint) ---
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=fleet-r2-vehicle-photos

# --- Durable Object publish endpoint ---
# In dev, this is the local Wrangler dev URL.
# In prod, it is the gateway Worker /internal/publish route.
DO_PUBLISH_URL=http://localhost:8787/internal/publish
